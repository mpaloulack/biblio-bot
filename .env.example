# --- Discord ---------------------------------------------------------------
# Onglet "Bot" du portail développeur Discord.
DISCORD_TOKEN=
# Identifiant du serveur de test : les commandes y sont disponibles tout de
# suite. Laisser vide enregistre les commandes globalement (jusqu'à 1 h de
# propagation côté Discord).
DISCORD_GUILD_ID=

# --- Prowlarr --------------------------------------------------------------
PROWLARR_URL=http://192.168.1.240:9696
PROWLARR_API_KEY=

# --- qBittorrent -----------------------------------------------------------
QBIT_URL=http://192.168.1.240:8081
# À renseigner seulement si le contournement d'authentification pour le réseau
# local est désactivé.
QBIT_USER=
QBIT_PASS=
# Catégorie qBittorrent visée. Son "Save Path" détermine où atterrissent les
# fichiers : le bot le lit et le transmet explicitement à chaque ajout.
QBIT_CATEGORY=ebooks

# --- Recherche -------------------------------------------------------------
# Catégories Newznab, séparées par des virgules.
# 7020 Books/EBook · 7000 Books · 7030 Comics · 7040 Technical · 3030 Audiobook
SEARCH_CATEGORIES=7020
# Nombre de résultats proposés (1-25, limite d'un menu Discord).
MAX_RESULTS=25

# --- Localisation ----------------------------------------------------------
# The bot answers each user in their own Discord language when it can (English
# or French). This is the fallback for every other locale: `en` or `fr`.
DEFAULT_LOCALE=en

# --- Standing searches -----------------------------------------------------
# When a search finds nothing, the bot offers to keep looking. It posts in the
# channel, mentioning you, as soon as something turns up; the entry is dropped
# once you actually download it.
# How many times a day each standing search is retried (1-24).
WATCH_CHECKS_PER_DAY=4
# A standing search gives up after this many days (1-365).
WATCH_MAX_DAYS=30
# Per-user limit (1-100).
WATCH_MAX_PER_USER=10
# Where the list is stored. The container image already points this at its
# /data volume, so leave it alone unless you run the binary directly.
WATCHLIST_PATH=data/watchlist.json

# --- Logs ------------------------------------------------------------------
# Default: biblio_bot=info,serenity=warn
# Use biblio_bot=debug to see each watch check, or add serenity=info to trace
# the gateway.
RUST_LOG=biblio_bot=info,serenity=warn
